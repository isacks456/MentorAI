# Шаблон переменных окружения frontend (Vite).
# Скопируйте в .env и задайте реальное значение. Файл .env в Git не коммитится.

# Базовый адрес backend API.
# Примеры:
#   локально: VITE_API_URL=http://localhost:5056
#   на сервере: VITE_API_URL=https://api.example.com
VITE_API_URL=http://localhost:5056
