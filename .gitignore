# ==========================================================================
# MentorAI — .gitignore
# Frontend: React + Vite | Backend: ASP.NET Core / .NET | DB: SQLite
#
# Игнорируем только генерируемое, локальное и конфиденциальное.
# НЕ игнорируем: исходный код, миграции EF Core, package.json / lock-файлы,
# .csproj / .sln, документацию и безопасные шаблоны (.env.example и т.п.).
# ==========================================================================

# ---------------------------------------------------------------------------
# Frontend (React + Vite)
# ---------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
coverage/

# Vite / npm локальные кеши и отчёты
.vite/
*.local
.eslintcache
.oxlintcache

# ---------------------------------------------------------------------------
# Переменные окружения (секреты)
# ---------------------------------------------------------------------------
.env
.env.local
.env.*.local
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Backend (.NET / ASP.NET Core)
# ---------------------------------------------------------------------------
bin/
obj/
*.user
*.suo
*.userosscache
*.sln.docstates

# Результаты тестов и покрытие
[Tt]est[Rr]esult*/
*.coverage
*.coveragexml

# ---------------------------------------------------------------------------
# IDE / редакторы
# ---------------------------------------------------------------------------
.vs/
.vscode/
.idea/
*.swp
*.swo
*~

# ---------------------------------------------------------------------------
# База данных SQLite и резервные копии
# ---------------------------------------------------------------------------
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3

# Локальные каталоги резервных копий БД (содержат пользовательские данные)
backups/

# ---------------------------------------------------------------------------
# Секреты, сертификаты и приватные ключи
# ---------------------------------------------------------------------------
secrets.json
*.pfx
*.p12
*.pem
*.key
*.crt
*.cer

# ---------------------------------------------------------------------------
# Логи и временные файлы
# ---------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.tmp
*.temp
